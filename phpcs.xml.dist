<?xml version="1.0"?>
<ruleset name="Beplus Performance Booster">
    <description>WPCS ruleset for the Beplus Performance Booster plugin.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_supported_wp_version" value="5.0"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!--
        lib/object-cache.php is a WordPress drop-in with its own contract
        (no ABSPATH guard pattern the same as regular includes, ships as a
        standalone bootstrap file) — some WordPress-Extra file-header rules
        don't apply to it the same way. Don't loosen security-relevant
        sniffs (escaping, nonce, SQL) — only structural/file-org sniffs if
        they produce false positives here.
        -->
    </rule>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
        <!-- lib/object-cache.php intentionally uses serialize()/unserialize()
             for the cache payload wire format; unserialize() calls MUST use
             allowed_classes => false (see CLAUDE.md rule #2). Sniff stays
             active as a reminder to re-check this on every touch. -->
    </rule>
</ruleset>
